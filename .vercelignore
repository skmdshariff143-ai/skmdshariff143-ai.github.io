# Vercel CLI — files excluded from the deployment upload.
# The site is static: everything not listed here is legitimate public content
# (HTML/CSS/JS, data/*.json, assets/images, certificates, resume).
# NOTE: robots.txt is NOT access control — these files must never be uploaded.

# --- Secrets / local credentials (never upload) ---
.env
.env.*
.env.local
.vercel/
*.pem
*.key

# --- Development-only tooling, reports and audit trail ---
PROJECT_ROADMAP.md
.git/
.gitignore
.gitattributes
run_qa.py
requirements.txt
qa_results.json
qa-artifacts/
scripts/
CHECKPOINT*.md
HANDOFF*.md
RECONCILE-PROVENANCE.txt
CERTIFICATE_WORKFLOW.md
AGENTS.md
GEMINI.md
.agent/
.agents/
graphify-out/

# --- Redundant / legacy trees that must never become the published root ---
public/
assets/certificates-backup/
