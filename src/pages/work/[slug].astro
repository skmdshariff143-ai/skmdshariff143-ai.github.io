---
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import WorkLinks from "../../components/WorkLinks.astro";
import Base from "../../layouts/Base.astro";
import { getCaseStudy, getProfile, getProjects } from "../../lib/content";

export function getStaticPaths() {
  return getProjects("flagship").map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const study = getCaseStudy(project.slug);
const flagships = getProjects("flagship");
const nextProject = flagships[(flagships.findIndex((item) => item.slug === project.slug) + 1) % flagships.length];
const { role, stack } = project;
if (!role || !stack) throw new Error(`Project ${project.slug} needs a role and stack.`);
---
<Base
  title={`${project.title} case study | Shaik Mahammad Shariff`}
  description={project.summary}
  preloadImage={study.image.name}
>
  <article>
    <header class="case-hero wrap">
      <p class="kicker">Case study</p>
      <h1>{project.title}</h1>
      <p class="case-summary">{project.summary}</p>
      <dl class="case-meta">
        <div><dt>My role</dt><dd>{role}</dd></div>
        <div><dt>Stack</dt><dd>{stack}</dd></div>
        <div><dt>Links</dt><dd><WorkLinks project={project} showCaseStudy={false} /></dd></div>
      </dl>
    </header>

    <div class="wrap">
      <figure class="case-picture shot">
        <ResponsiveImage
          name={study.image.name}
          width={study.image.width}
          height={study.image.height}
          sizes="(max-width: 1180px) 100vw, 1084px"
          eager
          alt={study.image.alt}
        />
      </figure>

      <div class="case-body">
        <section class="case-section">
          <h2>Problem</h2>
          <div class="case-copy">{study.problem.map((text) => <p>{text}</p>)}</div>
        </section>

        <section class="case-section">
          <h2>Users</h2>
          <div class="case-copy"><p>{study.audience}</p></div>
        </section>

        <section class="case-section">
          <h2>My role</h2>
          <div class="case-copy">{study.contribution.map((text) => <p>{text}</p>)}<p>{getProfile().aiNote}</p></div>
        </section>

        <section class="case-section">
          <h2>Key decisions and trade-offs</h2>
          <div class="case-copy">{study.decisions.map((decision) => <p><b>{decision.title}</b> {decision.text}</p>)}</div>
        </section>

        <section class="case-section">
          <h2>What I built</h2>
          <div class="case-copy">
            <p>{project.built}</p>
            <ol class="flow">{study.flow.map((step) => <li>{step}</li>)}</ol>
          </div>
        </section>

        <section class="case-section">
          <h2>How I validated it</h2>
          <div class="case-copy"><p>{project.checked}</p></div>
        </section>

        {study.incident && (
          <section class="case-section">
            <h2>{study.incident.title}</h2>
            <div class="case-copy"><p>{study.incident.text}</p></div>
          </section>
        )}

        <section class="case-section">
          <h2>Outcome</h2>
          <div class="case-copy"><ul>{study.results.map((result) => <li>{result}</li>)}</ul></div>
        </section>

        <section class="case-section">
          <h2>Limits</h2>
          <div class="case-copy"><ul>{study.limits.map((limit) => <li>{limit}</li>)}</ul></div>
        </section>

        <section class="case-section">
          <h2>What I would do next</h2>
          <div class="case-copy"><p>{study.next}</p></div>
        </section>
      </div>
    </div>
  </article>

  {nextProject && (
    <section class="wrap next-case">
      <p class="kicker">Next case study</p>
      <h2><a href={`/work/${nextProject.slug}/`}>{nextProject.title}</a></h2>
    </section>
  )}
</Base>
