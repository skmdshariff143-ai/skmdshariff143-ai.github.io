---
import { getProfile } from "../lib/content";

const profile = getProfile();
---
<header class="bar">
  <div class="bar-inner">
    <a class="mark" href="/">{profile.shortName}</a>
    <nav aria-label="Main">
      <a href="/#work">Work</a>
      <a href="/#about">About</a>
      <a href="/assets/resume.pdf" download="Shaik_Mahammad_Shariff_Resume.pdf">Resume</a>
      <a href="/#contact">Contact</a>
    </nav>
    <span class="clock" data-clock={profile.location.split(",")[0]}>{profile.location.split(",")[0]}</span>
  </div>
</header>
