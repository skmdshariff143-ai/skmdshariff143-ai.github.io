---
import { getProfile } from "../lib/content";

const profile = getProfile();
---
<section class="contact" id="contact">
  <div>
    <h2>Hiring for an AI product role?</h2>
    <p>Send a message here, or reach me on <a href={profile.linkedin}>LinkedIn</a>. My code is on <a href={profile.github}>GitHub</a>.</p>
    <a class="button quiet-dark" href="/assets/resume.pdf" download="Shaik_Mahammad_Shariff_Resume.pdf">Download resume</a>
  </div>
  <form action={profile.formEndpoint} method="post" data-contact-form data-linkedin={profile.linkedin}>
    <label class="honeypot" aria-hidden="true">Leave this empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
    <label for="name">Your name</label>
    <input id="name" name="name" autocomplete="name" minlength="2" maxlength="100" required />
    <label for="email">Your email</label>
    <input id="email" name="email" type="email" autocomplete="email" required />
    <label for="message">Message</label>
    <textarea id="message" name="message" rows="3" minlength="10" maxlength="5000" required></textarea>
    <button class="button" type="submit">Send message</button>
    <p class="form-status" data-form-status role="status" tabindex="-1"></p>
    <p class="note">Messages go through Formspree. Read the <a href="/privacy/">privacy policy</a>.</p>
  </form>
</section>

<script>
  import { initContactForm } from "../scripts/contact";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const status = document.querySelector<HTMLElement>("[data-form-status]");
  if (form && status) initContactForm(form, status);
</script>
