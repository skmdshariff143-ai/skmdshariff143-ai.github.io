---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource/instrument-sans/400.css";
import "@fontsource/instrument-sans/500.css";
import "@fontsource/instrument-sans/600.css";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { getProfile } from "../lib/content";

interface Props {
  title: string;
  description: string;
  image?: string;
  preloadImage?: string;
}

const { title, description, image = "/images/og-default.png", preloadImage } = Astro.props;
const profile = getProfile();
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: profile.website,
  jobTitle: "Engineering student and AI product builder",
  alumniOf: { "@type": "CollegeOrUniversity", name: "Vasireddy Venkatadri Institute of Technology" },
  sameAs: [profile.linkedin, profile.github, profile.codechef],
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <meta name="theme-color" content="#10291f" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} type="image/webp" />}
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { initReveal } from "../scripts/reveal";
      initReveal();
    </script>
  </body>
</html>
